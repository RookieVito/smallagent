{
  "openapi": "3.1.0",
  "info": {
    "title": "智能旅行助手 API",
    "description": "智能旅行规划助手后端服务，提供行程规划与编辑能力",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "健康检查"
        ],
        "summary": "健康检查",
        "description": "返回服务运行状态，用于负载均衡探活。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/trip/plan": {
      "post": {
        "tags": [
          "行程规划"
        ],
        "summary": "创建旅行计划",
        "description": "提交旅行偏好，后端生成完整的多日行程计划，包含景点、天气、预算和地图数据。",
        "operationId": "create_trip_plan_api_trip_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripPlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "规划成功，返回完整 TripPlan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripPlan-Output"
                }
              }
            }
          },
          "422": {
            "description": "请求参数验证失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "主链路服务不可用（景点/天气），规划失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/trip/edit": {
      "post": {
        "tags": [
          "行程规划"
        ],
        "summary": "编辑旅行计划",
        "description": "对已有行程计划执行景点级别的编辑操作：删除景点或调整景点顺序。返回编辑后的完整 TripPlan，plan_version 自增。",
        "operationId": "edit_trip_plan_api_trip_edit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EditRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "编辑成功，返回更新后的 TripPlan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TripPlan-Output"
                }
              }
            }
          },
          "422": {
            "description": "请求参数验证失败或索引越界",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
