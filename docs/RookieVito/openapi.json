            "minimum": -90.0,
            "title": "Latitude",
            "description": "纬度"
          },
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "description": "经度"
          },
          "suggested_duration_minutes": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Suggested Duration Minutes",
            "description": "建议游览时长（分钟）"
          },
          "ticket_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ticket Price",
            "description": "门票价格（CNY），免费景点为 null"
          },
          "image_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image Url",
            "description": "景点图片 URL，未补全时为 null"
          }
        },
        "type": "object",
        "required": [
          "name",
          "address",
          "latitude",
          "longitude",
          "suggested_duration_minutes"
        ],
        "title": "Attraction",
        "description": "单个景点信息。"
      },
